[submodule "firmware/lib/pico-sdk"]
	path = firmware/lib/pico-sdk
	url = https://github.com/raspberrypi/pico-sdk.git
[submodule "firmware/lib/tinyusb"]
	path = firmware/lib/tinyusb
	url = https://github.com/hathach/tinyusb.git
[submodule "firmware/lib/ioLibrary_Driver"]
	path = firmware/lib/ioLibrary_Driver
	url = https://github.com/Wiznet/ioLibrary_Driver.git
[submodule "firmware/lib/monocypher"]
	path = firmware/lib/monocypher
	url = https://github.com/LoupVaillant/Monocypher.git
